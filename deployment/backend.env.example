# Production backend (Docker service: api). Copy to a private server env file.
# REQUIRED: fill in the subsystem's real PostgreSQL URL before starting.
# URL-encode special characters in the database password.
DATABASE_URL=
NODE_ENV=production
PORT=4000
TZ=Asia/Bangkok
DATABASE_POOL_MAX=5
PERSONNEL_DEPARTMENT_CODE=CS
AUTH_MODE=gateway
SUBSYSTEM_ID=csmju-interactive-map
FRONTEND_URL=https://csmju-interactive-map.jowave.com
CORS_ORIGIN=https://csmju-interactive-map.jowave.com
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_WEB_URL=https://csmju2030.jowave.com
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030
# Register this callback in Core Hub (not an environment variable):
# https://csmju-interactive-map.jowave.com/auth/callback
